# Postgres connection string (Render gives you this when you create a Postgres instance)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string used to sign login sessions — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Cloudinary (free tier, for storing uploaded post images) - from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# The public URL of your deployed app (Render gives you this after first deploy)
CLIENT_URL=https://your-app.onrender.com

PORT=3000
